{
  "name": "singularity-agent",
  "version": "0.5.0",
  "description": "Universal CLI + MCP plugin for practical blockchain interaction across EVM, Solana, Bitcoin and Cosmos.",
  "type": "module",
  "license": "MIT",
  "author": "Deadsg",
  "homepage": "https://github.com/DarkStarMatters/Singularity-Agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DarkStarMatters/Singularity-Agent.git"
  },
  "bugs": {
    "url": "https://github.com/DarkStarMatters/Singularity-Agent/issues"
  },
  "bin": {
    "singularity": "./dist/cli/index.js",
    "singularity-agent": "./dist/cli/index.js",
    "singularity-mcp": "./dist/mcp/server.js"
  },
  "workspaces": [
    "singularity-sdk"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./eliza": "./dist/eliza/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    ".claude-plugin",
    ".mcp.json"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.eliza.json",
    "dev": "tsx src/cli/index.ts",
    "mcp": "tsx src/mcp/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.eliza.json --noEmit && tsc -p tsconfig.api.json",
    "build:sdk": "npm run build && npm run build -w singularity-sdk",
    "typecheck:sdk": "npm run build && npm run typecheck -w singularity-sdk",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "bot": "tsx src/telegram/bot.ts",
    "x-bot": "tsx src/x/bot.ts",
    "agent": "tsx src/agent.ts",
    "smoke:burn": "node scripts/smoke-burn.mjs",
    "verify:builders": "npm run build && node scripts/verify-builders.mjs"
  },
  "keywords": [
    "mcp",
    "blockchain",
    "evm",
    "solana",
    "bitcoin",
    "cosmos",
    "cli",
    "claude",
    "web3",
    "elizaos",
    "eliza",
    "grok",
    "xai",
    "agent"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "commander": "^14.0.1",
    "viem": "^2.56.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@elizaos/core": "^1.7.2",
    "@types/node": "^22.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@elizaos/core": ">=1.7.0"
  },
  "peerDependenciesMeta": {
    "@elizaos/core": {
      "optional": true
    }
  },
  "overrides": {
    "rpc-websockets": {
      "uuid": "^11.1.0"
    }
  }
}
