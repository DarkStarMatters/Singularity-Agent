# Optional: override public RPC endpoints with your own (recommended for real use).
# Public endpoints are heavily rate-limited.
SINGULARITY_RPC_ETHEREUM=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
SINGULARITY_RPC_BASE=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
SINGULARITY_RPC_SOLANA=https://solana-mainnet.g.alchemy.com/v2/YOUR_KEY
SINGULARITY_RPC_BITCOIN=https://mempool.space/api
SINGULARITY_RPC_COSMOSHUB=https://rest.cosmos.directory/cosmoshub

# Path to a custom chain/config file (JSON). Default: ~/.singularity/config.json
SINGULARITY_CONFIG=

# ─── Transaction history ─────────────────────────────────────────────
# Solana, Bitcoin and Cosmos answer `history` from their own endpoints and need
# nothing here. EVM cannot: no JSON-RPC method enumerates an account's
# transactions, so it takes an index somebody has to build. One key from
# etherscan.io serves every supported EVM chain through their V2 API.
#
# Left empty, `history` on an EVM chain reports that it has no answer rather
# than returning an empty list. Those are different claims and only one of them
# is about the address.
SINGULARITY_ETHERSCAN_KEY=

# ─── Tap-to-burn (Solana Pay) ────────────────────────────────────────────
# The deployed /api/burn endpoint. Set it and /burn posts a `solana:` link the
# holder taps and approves in their own wallet; leave it empty and /burn falls
# back to handing them base64 to sign with their own tooling. Both are correct;
# only one of them is a thing people succeed at.
SINGULARITY_PAY_ENDPOINT=https://singularity-agent.cicada71.net/api/burn

# Comma-separated mints the endpoint will build a burn for. Defaults to this
# project's own mint. Deliberately not "any": a transaction request is a URL
# anybody can send to anybody, and wallets show its origin — so an endpoint that
# burns anything is a phishing primitive wearing whatever domain you host it on.
SINGULARITY_BURN_MINTS=

# The icon a wallet shows on the approval screen. Defaults to the icon served
# from the endpoint's own origin, which is where it should stay: it is the one
# element of that screen a wallet cannot vouch for if it comes from elsewhere.
SINGULARITY_PAY_ICON=

# Where `redeem` records the burns it has already spent.
# Default: ~/.singularity/burns.json
SINGULARITY_BURNS=

# ─── Telegram bot ────────────────────────────────────────────────────────────
# From @BotFather. Shape: <bot id>:<secret>
TELEGRAM_BOT_TOKEN=123456789:AA_your_bot_token_here
# Comma-separated chat ids the bot will serve. Empty = any chat.
# Group ids are negative, e.g. -1001234567890. Run /chatid in the group to find it.
TELEGRAM_ALLOWED_CHATS=
TELEGRAM_RATE_LIMIT_PER_MINUTE=20
TELEGRAM_DEFAULT_CHAINS=ethereum,base,arbitrum,solana
TELEGRAM_POLL_TIMEOUT_SECONDS=50

# ─── X / Twitter ─────────────────────────────────────────────────────────────
# OAuth 1.0a user-context credentials from developer.x.com. Posting requires all
# four; the bearer token alone is read-only and cannot publish.
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Must be exactly "true" before anything is published. Default drafts only.
# This gates replies from the X listener too, not just top-level posts.
X_POSTING_ENABLED=false

# ─── Approval & control (npm run agent) ──────────────────────────────────────
# Runs the Telegram bot and the X listener in one process, so Telegram can
# approve posts and control the X bot with /x.
#
# The chat that reviews posts and may control the X bot. ANYONE WHO CAN SEE
# THIS CHAT CAN PUBLISH TO THE ACCOUNT. Defaults to the single allowlisted chat
# when TELEGRAM_ALLOWED_CHATS names exactly one; otherwise approval stays off.
TELEGRAM_CONTROL_CHAT=
# Set to false to let the X bot publish without asking. Default: approval on
# whenever a control chat exists.
X_REQUIRE_APPROVAL=true

# ─── X listener (npm run x-bot) ──────────────────────────────────────────────
# Polls mentions and replies to them. Seconds between polls; X's Basic tier
# allows roughly one mentions call every 90s, and going lower just earns 429s.
X_POLL_SECONDS=90
# Compose replies but never send them, even with posting enabled. Use this
# first: it shows exactly what the agent would have said.
X_DRY_RUN=false
# Hard spending caps. Every reply costs an xAI completion plus an X write.
X_MAX_REPLIES_PER_HOUR=12
X_MAX_REPLIES_PER_AUTHOR_PER_HOUR=3
# Spam thresholds. The filter runs before the model, so junk costs nothing.
# These two only catch zero-audience throwaways — the real work is done by the
# on-topic test, which needs no configuration.
X_MIN_ACCOUNT_AGE_DAYS=7
X_MIN_FOLLOWERS=10
# Unprompted project updates: hours between posts, 0 to disable. Each post is
# written only from facts read out of the repo (version, chain registry, commit
# subjects), so it cannot announce something that did not happen.
X_UPDATE_INTERVAL_HOURS=4
# Where the "already answered" cursor and the update schedule live.
# Default: ~/.singularity/x-state.json
SINGULARITY_X_STATE=

# ─── X via OAuth 2.0 (preferred when set) ────────────────────────────────────
# An alternative to the four OAuth 1.0a values above, and usually the easier
# one: a 1.0a access token minted while the app was read-only stays read-only
# forever, while a 2.0 token carries the scopes it was granted (needs
# tweet.write). Obtain the pair with the authorization-code + PKCE flow.
#
# Refreshed tokens are written to ~/.singularity/x-tokens.json and take
# precedence over these — X rotates the refresh token on every use, so the
# values here are only a seed for the first run.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_OAUTH2_ACCESS_TOKEN=
X_OAUTH2_REFRESH_TOKEN=
# Where refreshed tokens live. Default: ~/.singularity/x-tokens.json
SINGULARITY_X_TOKENS=

# ─── Grok (xAI) ──────────────────────────────────────────────────────────────
# Keys come from console.x.ai and start with "xai-". An X/Twitter API key above
# is a different credential and will not work here.
XAI_API_KEY=
XAI_MODEL=grok-4
# Optional. Used for the cheap, high-frequency calls under elizaOS (TEXT_SMALL)
# so they need not run on the same model that writes posts. Defaults to XAI_MODEL.
XAI_SMALL_MODEL=

# Logs every update and the reason it was or was not handled. For diagnosing
# "the bot is not replying": a message that never arrived and one that arrived
# and was dropped look identical from outside.
TELEGRAM_DEBUG=false
