# Optional: override public RPC endpoints with your own (recommended for real use).
# Public endpoints are heavily rate-limited.
SINGULARITY_RPC_ETHEREUM=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
SINGULARITY_RPC_BASE=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
SINGULARITY_RPC_SOLANA=https://solana-mainnet.g.alchemy.com/v2/YOUR_KEY
SINGULARITY_RPC_BITCOIN=https://mempool.space/api
SINGULARITY_RPC_COSMOSHUB=https://rest.cosmos.directory/cosmoshub

# Path to a custom chain/config file (JSON). Default: ~/.singularity/config.json
SINGULARITY_CONFIG=

# ─── Telegram bot ────────────────────────────────────────────────────────────
# From @BotFather. Shape: <bot id>:<secret>
TELEGRAM_BOT_TOKEN=123456789:AA_your_bot_token_here
# Comma-separated chat ids the bot will serve. Empty = any chat.
# Group ids are negative, e.g. -1001234567890. Run /chatid in the group to find it.
TELEGRAM_ALLOWED_CHATS=
TELEGRAM_RATE_LIMIT_PER_MINUTE=20
TELEGRAM_DEFAULT_CHAINS=ethereum,base,arbitrum,solana
TELEGRAM_POLL_TIMEOUT_SECONDS=50

# ─── X / Twitter ─────────────────────────────────────────────────────────────
# OAuth 1.0a user-context credentials from developer.x.com. Posting requires all
# four; the bearer token alone is read-only and cannot publish.
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Must be exactly "true" before anything is published. Default drafts only.
X_POSTING_ENABLED=false

# ─── Grok (xAI) ──────────────────────────────────────────────────────────────
# Keys come from console.x.ai and start with "xai-". An X/Twitter API key above
# is a different credential and will not work here.
XAI_API_KEY=
XAI_MODEL=grok-4
# Optional. Used for the cheap, high-frequency calls under elizaOS (TEXT_SMALL)
# so they need not run on the same model that writes posts. Defaults to XAI_MODEL.
XAI_SMALL_MODEL=
